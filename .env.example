# ============================================================
# .env.example — 範本檔(此檔為唯一進 git 的版本)
# ------------------------------------------------------------
# 本專案有三個實際使用情境,請依用途複製成對應檔:
#   .env       本機開發 (docker-compose.dev.yml,env_file: .env)
#   .env.test  測試站 (Coolify + docker-compose-prod.yml)
#   .env.prod  正式站 (Coolify + docker-compose-prod.yml)
#
# 變數分為四類,於各區段以標示說明:
#   [BOTH]     local dev / test / prod 皆會載入並生效
#   [LOCAL]    僅本機 .env 生效;test/prod compose 內為寫死值,不讀此檔
#   [REMOTE]   僅 test/prod 生效;本機開發不需填
#   [COOLIFY]  正式部署由 Coolify 後台注入,禁止 commit 進 git
# ============================================================

# --- App [BOTH] ---
# APP_ENV: dev / test / prod;影響 is_prod() → cookie secure flag、Seq 環境標籤。
APP_ENV=dev
APP_NAME=backend
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=df-openrouter-dispatch

# --- Backend / Uvicorn [BOTH] ---
UVICORN_WORKERS=1
# SNOWFLAKE_WORKER_ID:Snowflake ID 產生器的 worker 編號(0–1023),預設 1。
# 用於對外業務代碼(目前為 projects.code → X-Project-Code)。
# ⚠ 多 worker 部署時每個 process 必須配發「不同」值,否則同毫秒會撞 ID。
# 詳見 docs/Design-Base/30-database.md § 7。
SNOWFLAKE_WORKER_ID=1

# --- Database [BOTH] ---
# DATABASE_URL 範例(dev):postgresql+asyncpg://<user>:<pass>@postgres:5432/<db>
# Alembic migration 會在 env.py 自動把 +asyncpg 改為 +psycopg(sync driver)。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Auth / Security [BOTH] ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
ENCRYPTION_KEY=
CORS_ORIGINS=

# --- Auth / Admin Bootstrap [BOTH] ---
INITIAL_ADMIN_ACCOUNT=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# 可選:首位 admin 的 Email。填入後 Seed 會寫入(或回填)admin.email,
# 使該帳號可直接以 DF-SSO 登入(SSO 以 Email 對應本地帳號)。
INITIAL_ADMIN_EMAIL=

# --- DF-SSO 登入器整合 [BOTH] ---
# SSO 中央伺服器位址(三者皆有值才啟用 SSO 登入):
#   Test: https://df-sso-login-test.apps.zerozero.tw
#   Prod: https://df-it-sso-login.it.zerozero.tw
# SSO_APP_ID / SSO_APP_SECRET 由對應環境的 SSO Dashboard 各自發放。
# ⚠ SSO_APP_SECRET 為機密:test/prod 改由 Coolify 後台注入,禁止 commit 進 git。
# BACKEND_URL  = 本後端對外 origin(SSO callback 落點;Dashboard redirect_uris 需登記此 origin)
# FRONTEND_URL = 本前端對外 origin(登入頁 / dashboard 落點)
SSO_URL=
SSO_APP_ID=
SSO_APP_SECRET=
BACKEND_URL=
FRONTEND_URL=

# [LOCAL] SSO_TIMEOUT_SECONDS:僅本機 .env 生效;
# docker-compose-prod.yml 寫死 "8",test/prod 不讀此值,故不放在 .env.test / .env.prod。
SSO_TIMEOUT_SECONDS=8

# --- OpenRouter [BOTH] ---
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_TIMEOUT=60
# 串流(SSE)端點 /model/chat/stream 專用 read timeout(秒);串流連線需長時間維持,
# chunk 間可能久無資料,故與 OPENROUTER_API_TIMEOUT 分開。
OPENROUTER_STREAM_TIMEOUT=300
# 申請單 AI 欄位驗證模型(經 OpenRouter 呼叫)
API_KEY_AGENT_MODEL=anthropic/claude-sonnet-4.6

# --- Internal LLM (本地 OpenAI-compatible server,v1.2) [BOTH] ---
# base_url / api_key / rpm_limit / min_request_interval_ms 已改放 `internal_keys` 表,
# 透過 /admin/internal-keys 後台管理(每把 Key 獨立設定)。此處僅留系統層級 timeout。
INTERNAL_LLM_REQUEST_TIMEOUT=120                # 單次呼叫 httpx timeout(秒)
INTERNAL_LLM_RATE_WAIT_TIMEOUT=60               # 全 Key 撞限額後最長等待秒數,超過 → 429 internal_busy

# --- Frontend [BOTH] ---
# 本機開發:http://localhost:8800(避免與其他專案衝突;若無衝突可改回 8000)
# 部署:對外可達的後端 origin
NEXT_PUBLIC_API_BASE_URL=

# --- Seq Log ---
# [LOCAL] SEQ_INGESTION_URL:僅本機 .env 生效;
# docker-compose-prod.yml 寫死 "http://seq",test/prod 不讀此值。
# 本機留空 → 只走 console,不對外連線。
SEQ_INGESTION_URL=
# [BOTH] SEQ_API_KEY:於 Seq 後台建立 API Key 後填入以保護 ingestion 端點(可留空)。
SEQ_API_KEY=
# [REMOTE] SEQ_FIRSTRUN_ADMINPASSWORD:Seq 首次啟動的 admin 密碼;
# 本機開發不啟用 Seq 故不需要,test/prod 部署前必填並妥善保管。
SEQ_FIRSTRUN_ADMINPASSWORD=

# --- Dev Seed [LOCAL] ---
# 僅本機開發方便:若填入則於首次啟動 Seed 一把預設 OpenRouter Key 至 SYSTEM 部門。
# ⚠ 正式環境(.env.test / .env.prod)禁止使用,改由 admin 後台手動建立。
# 留空時 AI 驗證一律降級人工(無可用 Key 即無法呼叫驗證模型)。
DEFAULT_OPENROUTER_KEY=

# ============================================================
# [COOLIFY] 機密建議由 Coolify 後台 Environment Variables 注入,
#           不寫入 .env.test / .env.prod 也不 commit 進 git。
# ------------------------------------------------------------
# SSO_APP_SECRET              SSO Dashboard 發放的 client secret
# ============================================================
