# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=df-openrouter-dispatch

# --- Backend / Uvicorn ---
UVICORN_WORKERS=1

# --- Database ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Flyway ---
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=
FLYWAY_LOCATIONS=filesystem:/flyway/sql

# --- Auth / Security ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
ENCRYPTION_KEY=
CORS_ORIGINS=

# --- Auth / Admin Bootstrap ---
INITIAL_ADMIN_ACCOUNT=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# --- OpenRouter ---
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_TIMEOUT=60
ALLOWED_MODELS=

# --- Dev Seed (optional) ---
# 本機開發方便：若填入則於首次啟動 Seed 一把預設 OpenRouter Key 至 SYSTEM 部門；
# 正式環境禁止使用，改由 admin 後台建立。
DEFAULT_OPENROUTER_KEY=

# --- Frontend ---
# 本機開發：http://localhost:8800（避免與其他專案衝突；若無衝突可改回 8000）
NEXT_PUBLIC_API_BASE_URL=
