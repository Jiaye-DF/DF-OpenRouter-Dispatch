# --- App ---
APP_ENV=dev
APP_NAME=backend
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=df-openrouter-dispatch

# --- Backend / Uvicorn ---
UVICORN_WORKERS=1

# --- Database ---
# DATABASE_URL 範例(dev):postgresql+asyncpg://<user>:<pass>@postgres:5432/<db>
# Alembic migration 會在 env.py 自動把 +asyncpg 改為 +psycopg(sync driver)。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Auth / Security ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
ENCRYPTION_KEY=
CORS_ORIGINS=

# --- Auth / Admin Bootstrap ---
INITIAL_ADMIN_ACCOUNT=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# 可選:首位 admin 的 Email。填入後 Seed 會寫入(或回填)admin.email,
# 使該帳號可直接以 DF-SSO 登入(SSO 以 Email 對應本地帳號)。
INITIAL_ADMIN_EMAIL=

# --- DF-SSO 登入器整合 ---
# SSO 中央伺服器位址(三者皆有值才啟用 SSO 登入):
#   Test: https://df-sso-login-test.apps.zerozero.tw
#   Prod: https://df-it-sso-login.it.zerozero.tw
# SSO_APP_ID / SSO_APP_SECRET 由對應環境的 SSO Dashboard 各自發放。
# ⚠ SSO_APP_SECRET 為機密:正式環境改由 Coolify 後台注入,禁止 commit 進 git。
# BACKEND_URL  = 本後端對外 origin(SSO callback 落點;Dashboard redirect_uris 需登記此 origin)
# FRONTEND_URL = 本前端對外 origin(登入頁 / dashboard 落點)
SSO_URL=
SSO_APP_ID=
SSO_APP_SECRET=
SSO_TIMEOUT_SECONDS=8
BACKEND_URL=
FRONTEND_URL=

# --- OpenRouter ---
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_TIMEOUT=60

# --- Internal LLM (本地 OpenAI-compatible server,v1.2) ---
# base_url / api_key / rpm_limit / min_request_interval_ms 已改放 `internal_keys` 表,
# 透過 /admin/internal-keys 後台管理(每把 Key 獨立設定)。
# 此處僅留系統層級 timeout。
INTERNAL_LLM_REQUEST_TIMEOUT=120                # 單次呼叫 httpx timeout(秒)
INTERNAL_LLM_RATE_WAIT_TIMEOUT=60               # 全 Key 撞限額後最長等待秒數,超過 → 429 internal_busy

# --- Dev Seed (optional) ---
# 本機開發方便：若填入則於首次啟動 Seed 一把預設 OpenRouter Key 至 SYSTEM 部門；
# 正式環境禁止使用，改由 admin 後台建立。
DEFAULT_OPENROUTER_KEY=

# --- Frontend ---
# 本機開發：http://localhost:8800（避免與其他專案衝突；若無衝突可改回 8000）
NEXT_PUBLIC_API_BASE_URL=

# --- Seq Log (集中式 Log) ---
# SEQ_INGESTION_URL 留空則只走 console,本機開發 / CI 不會嘗試連線；
# 正式環境由 docker-compose-prod.yml 注入 http://seq。
# SEQ_API_KEY：於 Seq 後台建立 API Key 後填入以保護 ingestion 端點(可留空)。
SEQ_INGESTION_URL=
SEQ_API_KEY=
