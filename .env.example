# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=df-openrouter-dispatch

# --- Backend / Uvicorn ---
UVICORN_WORKERS=1

# --- Database ---
# DATABASE_URL 範例(dev):postgresql+asyncpg://<user>:<pass>@postgres:5432/<db>
# Alembic migration 會在 env.py 自動把 +asyncpg 改為 +psycopg(sync driver)。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Auth / Security ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
ENCRYPTION_KEY=
CORS_ORIGINS=

# --- Auth / Admin Bootstrap ---
INITIAL_ADMIN_ACCOUNT=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# --- OpenRouter ---
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_TIMEOUT=60

# --- Internal LLM (本地 OpenAI-compatible server,v1.2) ---
# base_url / api_key / rpm_limit / min_request_interval_ms 已改放 `internal_keys` 表,
# 透過 /admin/internal-keys 後台管理(每把 Key 獨立設定)。
# 此處僅留系統層級 timeout。
INTERNAL_LLM_REQUEST_TIMEOUT=120                # 單次呼叫 httpx timeout(秒)
INTERNAL_LLM_RATE_WAIT_TIMEOUT=60               # 全 Key 撞限額後最長等待秒數,超過 → 429 internal_busy

# --- Dev Seed (optional) ---
# 本機開發方便：若填入則於首次啟動 Seed 一把預設 OpenRouter Key 至 SYSTEM 部門；
# 正式環境禁止使用，改由 admin 後台建立。
DEFAULT_OPENROUTER_KEY=

# --- Frontend ---
# 本機開發：http://localhost:8800（避免與其他專案衝突；若無衝突可改回 8000）
NEXT_PUBLIC_API_BASE_URL=
